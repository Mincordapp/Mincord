<!-- What software centers and AppImage catalogs show for Mincord. -->
<component type="desktop-application">
  <id>io.github.mincord.Mincord</id>
  <name>Mincord</name>
  <summary>A Discord client without the web browser</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.mincord">
    <name>wiredtenshi</name>
  </developer>
  <description>
    <p>
      Mincord talks to Discord's API itself and draws its own window with Slint
      and Skia, so it runs in about 30 MB of RAM, where Discord's own app takes 720.
    </p>
    <p>
      Servers, DMs, threads, forums, friends, voice, screen sharing and GIFs are
      all there, laid out the way Discord lays them out.
    </p>
  </description>
  <launchable type="desktop-id">io.github.mincord.Mincord.desktop</launchable>
  <url type="homepage">https://mincord.com</url>
  <url type="bugtracker">https://github.com/mincord/mincord/issues</url>
  <url type="vcs-browser">https://github.com/mincord/mincord</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/mincord/mincord/main/docs/images/mincord.png</image>
      <caption>A group DM, with the server list, the conversation and its members</caption>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
  <releases>
